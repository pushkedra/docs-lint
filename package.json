{
  "name": "docs-lint",
  "version": "0.1.0",
  "description": "One lint for the markdown people and agents both read: shared markdownlint rules, American-English spelling, hard-wrap and link checks.",
  "keywords": [
    "markdown",
    "lint",
    "markdownlint",
    "cspell",
    "spelling",
    "documentation",
    "llm",
    "agents"
  ],
  "license": "MIT",
  "author": "Ivan Pushkedra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushkedra/docs-lint.git"
  },
  "type": "module",
  "bin": {
    "docs-lint": "dist/cli.js"
  },
  "exports": {
    "./markdownlint": {
      "types": "./dist/config/markdownlint.d.ts",
      "default": "./dist/config/markdownlint.js"
    },
    "./cspell": "./config/cspell.json"
  },
  "files": [
    "dist",
    "config",
    "dict",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "node dist/cli.js",
    "pretest": "npm run build",
    "test": "npm run typecheck && node --test \"test/*.test.ts\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "cspell": "10.3.6",
    "markdownlint": "0.42.0",
    "markdownlint-cli2": "0.24.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
