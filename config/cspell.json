// The spell check. A repository imports this from its own `cspell.json` and adds its words and
// exclusions there. A word the checker flags is fixed, not added: only a real term — a library, a
// tool, a domain word, a proper name — goes into a word list.
{
  "version": "0.2",

  // American spelling. en-US alone accepts many British forms as variants of its own words
  // (honour, centre, artefact, grey), so american-spelling.txt forbids them, each inflection
  // spelled out, with the American form as the suggestion.
  "language": "en-US",

  // Markdown only. Code follows its own conventions, and a per-file setting cannot separate its
  // identifiers from its text.
  "files": ["**/*.md"],

  // This file sits in node_modules, and a relative glob resolves against the file that holds it.
  "globRoot": "${cwd}",

  // The same exclusions as config/markdownlint.mjs, which this file cannot read.
  "ignorePaths": [
    "**/.git/**",
    "**/node_modules/**",
    ".idea/**",
    ".vscode/**"
  ],

  "dictionaryDefinitions": [
    { "name": "american-spelling", "path": "../dict/american-spelling.txt" },
    { "name": "common-words", "path": "../dict/common-words.txt" }
  ],
  "dictionaries": ["american-spelling", "common-words"],

  // A code span or a fenced block holds identifiers, paths and commands, which are respelled by
  // nobody; Cyrillic is another language's text, not an English misspelling. A code span closes on
  // a run of as many backticks as opened it, so a span quoting a backtick does not unbalance the line.
  "patterns": [
    { "name": "fenced-code", "pattern": "/^[ \\t]*(`{3,}|~{3,})[\\s\\S]*?^[ \\t]*\\1/gm" },
    { "name": "inline-code", "pattern": "/(?<!`)(`+)(?!`)[^\\n]*?(?<!`)\\1(?!`)/g" },
    { "name": "cyrillic", "pattern": "/[\\u0400-\\u04FF]+/g" }
  ],
  "ignoreRegExpList": ["fenced-code", "inline-code", "cyrillic"]
}
